<%= simple_form_for(pet) do |f| %>
  <%= f.input :name %>
  <%= f.input :species, collection: Pet::SPECIES %>
  <%= f.input :address %>
  <%= f.input :found_on %>
  <%= f.submit "Save", class: "btn btn-primary" %>
<% end %>
